{
	"servers": {
		"basic-stdio-mcp": {
			"type": "stdio",
			"command": "uv",
			"cwd": "${workspaceFolder}",
			"args": [
				"run",
				"servers/basic-stdio-server.py"
			]
		},
		"basic-http-mcp": {
			"type": "http",
			"url": "http://127.0.0.1:8000/mcp"
		},
		"expenses-mcp": {
			"type": "stdio",
			"command": "uv",
			"cwd": "${workspaceFolder}",
			"args": [
				"run",
				"servers/advanced-stdio-server.py"
			]
		},
		"expenses-tracker-http-server": {
			"url": "http://0.0.0.0:8001/mcp",
			"type": "http"
		},
		"expenses-tracker-inmemory-mcp": {
			"url": "http://0.0.0.0:8003/mcp",
			"type": "http"
		},
		"expenses-mcp-debug": {
			"type": "stdio",
			"command": "uv",
			"cwd": "${workspaceFolder}",
			"args": [
				"run",
				"--",
				"python",
				"-m",
				"debugpy",
				"--listen",
				"0.0.0.0:5678",
				"servers/advanced-stdio-server.py"
			]
		},
	},
	"inputs": []
}