{
	"servers": {
		"basic-stdio-mcp": {
			"type": "stdio",
			"command": "uv",
			"cwd": "${workspaceFolder}",
			"args": [
				"run",
				"servers/basic-stdio-server.py"
			]
		},
		"basic-http-mcp": {
			"type": "http",
			"url": "http://127.0.0.1:8000/mcp"
		},
		"advanced-stdio-mcp": {
			"type": "stdio",
			"command": "uv",
			"cwd": "${workspaceFolder}",
			"args": [
				"run",
				"servers/advanced-stdio-server.py"
			]
		},
		"advanced-http-mcp": {
			"url": "http://0.0.0.0:8001/mcp",
			"type": "http"
		},
		"expenses-tracker-inmemory-mcp": {
			"url": "http://0.0.0.0:8003/mcp",
			"type": "http"
		},
		"expenses-mcp-debug": {
			"type": "stdio",
			"command": "uv",
			"cwd": "${workspaceFolder}",
			"args": [
				"run",
				"--",
				"python",
				"-m",
				"debugpy",
				"--listen",
				"0.0.0.0:5678",
				"servers/advanced-stdio-server.py"
			]
		},
		"Elicitation-server": {
			"type": "stdio",
			"command": "uv",
			"cwd": "${workspaceFolder}",
			"args": [
				"run",
				"servers/Elicitation/elicitation-stdio-server.py"
			]
		},
		"sampling-demo-server": {
			"url": "http://0.0.0.0:8004/mcp",
			"type": "http"
		},
		"travily-mcp": {
			"url": "https://mcp.tavily.com/mcp/?tavilyApiKey=${input:tavily-api-key}",
			"type": "http"
		}
	},
	"inputs": [
		{
			"type": "promptString",
			"id": "tavily-api-key",
			"description": "Tavily API key",
			"password": true
		}
	]
}